# ===== Telegram =====
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Ваш Telegram user id (узнать у @userinfobot). Можно несколько через запятую.
ADMIN_IDS=111111111
# Куда бот шлёт сообщения из кнопки "Связаться" (обычно = ваш id или id чата поддержки)
SUPPORT_CHAT_ID=111111111

# ===== Бэкенд панели =====
# Какой панелью рулит бот: xui | marzban
PANEL_BACKEND=xui

# ===== Marzban (если PANEL_BACKEND=marzban) =====
# URL панели (обычный, без секрет-пути)
MARZBAN_URL=https://mon.your-domain.tld
# Логин/пароль sudo-админа (marzban cli admin create --sudo)
MARZBAN_USERNAME=
MARZBAN_PASSWORD=
# Стратегия авто-сброса трафика: no_reset | day | week | month | year
MARZBAN_RESET_STRATEGY=month
# Опционально: чем создавать юзера (JSON). Пусто → бот берёт ВСЕ инбаунды панели.
# Пример: MARZBAN_PROXIES={"vless":{"flow":"xtls-rprx-vision"}}
MARZBAN_PROXIES=
# Пример: MARZBAN_INBOUNDS={"vless":["VLESS TCP REALITY"]}
MARZBAN_INBOUNDS=

# ===== Авторазвёртывание нод («🖥 Добавить сервер» в админке) =====
# Открывает единственный входящий HTTP-порт (см. bot/http_api.py) — бот
# обычно работает только long-polling, без входящих портов вообще. Осознанное
# исключение, включай явно. За Cloudflare нужен TLS на этом порту — см.
# docker-compose.yml (переиспользует cert панели) и node/TROUBLESHOOTING.md.
NODE_PROVISION_ENABLED=false
NODE_PROVISION_PORT=8443
NODE_TOKEN_TTL_SECONDS=1800
# Каталог с fullchain.pem/key.pem панели на ХОСТЕ (не в контейнере) — по
# умолчанию подходит, если бот и Marzban на одной машине (обычный случай).
MARZBAN_CERT_DIR=/var/lib/marzban/certs

# ===== 3X-UI (если PANEL_BACKEND=xui) =====
# Базовый URL панели ВКЛЮЧАЯ секретный путь, без /panel на конце.
# Пример: https://your-domain.tld:ПАНЕЛЬ_ПОРТ/секретный-путь
XUI_BASE_URL=https://CHANGE_ME
# Способ авторизации: token (рекомендуется, 3X-UI >= 3.0.2) или login
XUI_AUTH=token
# Если XUI_AUTH=token — именованный API-токен из настроек панели:
XUI_API_TOKEN=
# Если XUI_AUTH=login — логин/пароль админа панели:
XUI_USERNAME=
XUI_PASSWORD=
# Двухфакторный код панели, если включён 2FA (иначе пусто)
XUI_2FA_SECRET=

# ===== Параметры выдаваемой подписки =====
# Срок подписки за одну оплату, дней
PLAN_DAYS=30
# Скрытый лимит трафика, ГБ (клиенту НЕ показываем)
PLAN_TRAFFIC_GB=150
# Список ID инбаундов, которые вешаются на нового клиента (через запятую).
# На вашей панели целевой inbound = 1 (vless, xtls-rprx-vision).
DEFAULT_INBOUND_IDS=1
# flow клиента (на вашем inbound — xtls-rprx-vision)
CLIENT_FLOW=xtls-rprx-vision
# Шаблон ссылки-подписки с плейсхолдером {subId}.
# Формат: https://<домен>:<порт-подписок>/<секретный-путь>/{subId}
# Порт подписок (subPort) задаётся в настройках панели → отдельный от порта панели.
# Пример (ваш реальный формат — замените домен, порт и секретный путь на свои):
# SUB_URL_TEMPLATE=https://your-sub-domain.tld:SUB_ПОРТ/sub-путь/{subId}
SUB_URL_TEMPLATE=

# ===== Прочее =====
# Цена тарифа по умолчанию (можно менять в админке бота)
DEFAULT_PRICE=199
# Реквизиты для перевода по умолчанию (можно менять в админке бота)
DEFAULT_REQUISITES=Сбербанк 0000 0000 0000 0000 (Имя Ф.)
# Путь к файлу БД
DB_PATH=data/bot.db
# За сколько дней до конца слать напоминания (через запятую)
REMIND_DAYS_BEFORE=3,1,0
# Час (по времени сервера), когда крутится ежедневный обход
REMIND_HOUR=11

# ===== Бэкап в Cloudflare R2 (опционально) =====
# Мастер-выключатель. false — фича полностью выключена (можно ещё ставить на паузу
# из админки бота в один клик). Бэкап уходит раз в сутки вместе с отбивкой.
BACKUP_ENABLED=false
# S3-эндпоинт R2: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Имя бакета
R2_BUCKET=vpn-backups
# Ключи R2-токена. ВАЖНО: токену давать ТОЛЬКО запись (PutObject), без удаления —
# ротацию делает lifecycle-правило бакета. Тогда взлом сервера не сотрёт бэкапы.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Публичный ключ age для шифрования бэкапа (age1...). НЕ секрет. Приватный ключ
# держи только у себя (менеджер паролей) — им расшифровываешь при восстановлении.
# Пусто — бэкап зальётся без шифрования (в приватный бакет это допустимо).
BACKUP_AGE_PUBKEY=
# Путь к x-ui.db НА ХОСТЕ (его смонтируем в контейнер для бэкапа). Пусто →
# /dev/null, и x-ui НЕ бэкапится (полезно, если бот стоит не рядом с панелью).
# deploy.sh подставит /etc/x-ui/x-ui.db при включённом бэкапе. Используется,
# только если PANEL_BACKEND=xui.
XUI_DB_HOST_PATH=
# То же самое для Marzban (PANEL_BACKEND=marzban) — обычно
# /var/lib/marzban/db.sqlite3, если бот стоит на той же машине, что панель.
MARZBAN_DB_HOST_PATH=
